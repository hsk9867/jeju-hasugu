{
  "name": "jeju-hasugu",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jeju-hasugu-db",
      "database_id": "16d781b1-e745-4907-b814-6e6838354162",
      "migrations_dir": "migrations"
    }
  ],
  "unsafe": {
    "bindings": [
      { "name": "LOGIN_LIMIT", "type": "ratelimit", "namespace_id": "3001", "simple": { "limit": 5, "period": 60 } },
      { "name": "TRACK_LIMIT", "type": "ratelimit", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } }
    ]
  }
  // 도메인을 연결하면 아래 주석을 풀고 npx wrangler deploy
  // ,"routes": [
  //   { "pattern": "example.com", "custom_domain": true },
  //   { "pattern": "www.example.com", "custom_domain": true }
  // ]
}
