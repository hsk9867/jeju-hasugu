{
  "name": "jeju-hasugu",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jeju-hasugu-db",
      "database_id": "16d781b1-e745-4907-b814-6e6838354162",
      "migrations_dir": "migrations"
    }
  ],
  "unsafe": {
    "bindings": [
      { "name": "LOGIN_LIMIT", "type": "ratelimit", "namespace_id": "3001", "simple": { "limit": 5, "period": 60 } },
      { "name": "TRACK_LIMIT", "type": "ratelimit", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } }
    ]
  }
  ,"routes": [
    { "pattern": "xn--2e0b050bb7c63bca55k280c.com", "custom_domain": true },
    { "pattern": "www.xn--2e0b050bb7c63bca55k280c.com", "custom_domain": true }
  ]
}
